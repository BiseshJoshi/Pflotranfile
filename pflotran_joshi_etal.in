#Description: Conceptual batch transport models for NSF project Roller
#=========================== flow mode ========================================
SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_TRANSPORT transport
      MODE GIRT
    /
  /
CHECKPOINT
PERIODIC TIME 10 y
#TIMES d 200. 400. 800. 1000. 1200.
/
END
skip
   RESTART
    FILENAME ./Users/inamdarlab/OneDrive - University of Delaware - o365/Paper3/Richards_Exampletransport-100.0000y.chk
     RESET_TO_TIME_ZERO
   /
noskip
SUBSURFACE
#=========================== chemistry ========================================
CHEMISTRY
         PRIMARY_SPECIES
                H+
                H2O
                Cl-
                SO4--
                HCO3-
                SiO2(aq)
                Al+++
                Ca++
                Mg++
                Fe++
                Fe+++
                K+
                Na+
                O2(aq)
                HS-
                NO3-
                NO2-
                N2(aq)
                Ac-
                CO2(aq)*
                NH4+
		Mill1
		Mill2
	#	FeS(aq)
          /
         SECONDARY_SPECIES
                HAc
                AlAc+2
                AlAc2+
                CaAc+
                CaAc2
                FeAc+
                FeAc2
                KAc
                MgAc
                NaAc
                AlO+
                AlO2-
                AlOH++
                AlSO4+
                HAlO2(aq)
                #CO2(aq)
                CO3--
                CaCO3(aq)
                CaCl+
                CaCl2(aq)
                CaHCO3+
                CaHSiO3+
                CaNO3+
                CaOH+
                CaSO4(aq)
                Fe(CO3)2--
                Fe(OH)3-
                Fe(OH)4--
                FeCO3(aq)
                FeCl+
                FeCl++
                FeCl2(aq)
                FeHCO3+
                FeNO2++
                FeNO3++
                FeO(aq)
                FeO+
                FeO2-
                FeOH+
                FeOH++
                FeS(aq)
                FeSO4(aq)
                FeSO4+
                H2S(aq)
                H2SO4(aq)
                HFeO2(aq)
                HFeO2-
                HNO2(aq)
                HNO3(aq)
                HSO4-
                HSiO3-
                KCl(aq)
                KHSO4(aq)
                KOH(aq)
                KSO4-
                Mg4(OH)4++++
                MgCO3(aq)
                MgCl+
                MgHCO3+
                MgHSiO3+
                MgOH+
                MgSO4(aq)
                NH3(aq)
                NH4SO4-
                NaCO3-
                NaCl(aq)
                NaHCO3(aq)
                NaHSiO3(aq)
                NaOH(aq)
                NaSO4-
                OH-
                S--
          /

 MINERALS
#                SOM
         /
MINERAL_KINETICS
#        SOM
 #    RATE_CONSTANT 1.00d-10
  #   ACTIVATION_ENERGY 72.3d0
#    /
/
#=========================== Reaction Network ========================================

 # 1---------------------------- Acetate Consumption nitrite as electron acceptor DN--------------------------------------------

  MICROBIAL_REACTION
    REACTION   1.0000 Ac- + 2.6667  NO3- +  7.0 H+  <->   2.0000 HCO3- + 1.333 N2(aq) + 4.0 H2O
	 RATE_CONSTANT 8.50436126e-10 
    MONOD
      SPECIES_NAME NO3-
      HALF_SATURATION_CONSTANT  1.0d-5             ! B is the acceptor
      THRESHOLD_CONCENTRATION 1.d-30
    /
    MONOD
      SPECIES_NAME Ac-
      HALF_SATURATION_CONSTANT 1d-15     ! B is the acceptor
      THRESHOLD_CONCENTRATION 1.d-30
    /

    INHIBITION
      SPECIES_NAME O2(aq)
      TYPE MONOD
      INHIBITION_CONSTANT 1.61d-8   ! C is the product and inhibits when too high
    /
  /
# # 2---------------------------- Acetate Consumption nitrite as electron acceptor DNRA --------------------------------------------

  MICROBIAL_REACTION
    REACTION   1.0000 Ac- + 1.5000  NO3- +  8.0 H+   <->   1.500 NH4+ + 2.00 CO2(aq)* + 2.5 H2O
	 RATE_CONSTANT 7.08207255e-10 
    MONOD
      SPECIES_NAME NO3-
      HALF_SATURATION_CONSTANT  2.0d-6            ! B is the acceptor
      THRESHOLD_CONCENTRATION 1.d-30
    /
    MONOD
      SPECIES_NAME Ac-
      HALF_SATURATION_CONSTANT 1.d-15 		!C is the acceptor
      THRESHOLD_CONCENTRATION 1.d-30
    /
    INHIBITION
      SPECIES_NAME O2(aq)
      TYPE MONOD
      INHIBITION_CONSTANT 1.61d-8   ! C is the product and inhibits when too high
    /

  /

 # # 3----------------------------  chemolithoautotrophic DN --------------------------------------------

   MICROBIAL_REACTION
     REACTION   1.000 Fe++  + 0.2 NO3-  + 1.200 H+  <-> 0.10 N2(aq) + 1.000 Fe+++ +  0.600 H2O +0.10 Mill1
	 RATE_CONSTANT 8.22735328e-10 
     MONOD
       SPECIES_NAME NO3-
       HALF_SATURATION_CONSTANT 1.0d-5         ! A is the donor
       THRESHOLD_CONCENTRATION 1.d-30
     /
     MONOD
       SPECIES_NAME Fe++
       HALF_SATURATION_CONSTANT  1.d-5           ! B is the acceptor
       THRESHOLD_CONCENTRATION 1.d-30
     /
     INHIBITION
       SPECIES_NAME O2(aq)
       TYPE MONOD
       INHIBITION_CONSTANT 1.61d-8    ! C is the product and inhibits when too high
     /
   /
# # 4---------------------------- chemolithoautotrophic DNRA --------------------------------------------

   MICROBIAL_REACTION
     REACTION   1.000 Fe++  + 1.00 NO3-  + 10.00 H+  <-> 1.00 NH4+ + 1.000 Fe+++ +  3.00 H2O +1 Mill2
	 RATE_CONSTANT 2.57069924e-10 
     MONOD
       SPECIES_NAME NO3-
       HALF_SATURATION_CONSTANT 2.0d-6         ! A is the donor
       THRESHOLD_CONCENTRATION 1.d-30
     /
     MONOD
       SPECIES_NAME Fe++
       HALF_SATURATION_CONSTANT  1.d-5        ! B is the acceptor
       THRESHOLD_CONCENTRATION 1.d-30
     /
   INHIBITION
       SPECIES_NAME O2(aq)
       TYPE MONOD
       INHIBITION_CONSTANT 1.61d-8    ! C is the product and inhibits when too high
   /
/
# --------------------------------------- ## --------------------------------------- ## --------------------------------------- #
         DATABASE /Users/inamdarlab/Documents/pflotranfiles/database_DD.dat
#         DATABASE /work/pimhoff_group/users/Bisesh/My_files/Optimization/database_DD.dat
         LOG_FORMULATION
         ACTIVITY_COEFFICIENTS OFF
         OUTPUT
                 all
                 TOTAL
                 FREE_ION
                 MINERAL_SATURATION_INDEX
          /
END
#=========================== numerical methods ================================
NUMERICAL_METHODS TRANSPORT

  LINEAR_SOLVER
    SOLVER DIRECT
  /
  NEWTON_SOLVER
  ATOL 1.e-10
  RTOL 1.e-10
  STOL 1.e-30
  ITOL 1.e-10
  /
END
#=========================== discretization ===================================
GRID
  TYPE STRUCTURED
  NXYZ 1 1 1
  BOUNDS
    0.d0 0.d0 0.d0
    1.d0 1d0 1.d0
  /
END

#=========================== fluid properties =================================
FLUID_PROPERTY
  PHASE LIQUID
  DIFFUSION_COEFFICIENT 1.d-9 !2.4d-9
END

#=========================== material properties ==============================
MATERIAL_PROPERTY soil1
  ID 99
  POROSITY 0.4d0
#  TORTUOSITY  0.67 ! 0.80 !0.5d0 
  TORTUOSITY 0.5d0 ! 0.8d0 
  #ROCK_DENSITY 2400.d0 !2700.d0
  LONGITUDINAL_DISPERSIVITY 5.0E-04 !2.13e-5 
  PERMEABILITY
    PERM_ISO 3.15e-12
  /
  CHARACTERISTIC_CURVES sf1
END

#=========================== characteristic curves =============================
CHARACTERISTIC_CURVES sf1 
   SATURATION_FUNCTION VAN_GENUCHTEN 
   M 0.2857
   ALPHA   3.56778e-4 
   LIQUID_RESIDUAL_SATURATION 1.0
  / 
   PERMEABILITY_FUNCTION MUALEM_VG_LIQ 
   M 0.2857
    LIQUID_RESIDUAL_SATURATION 1.0
  / 
END 
#=========================== output options ===================================
OUTPUT 
  TIMES y 0.00001 0.000114  0.00035 0.001 0.00274 0.005 0.01 0.02 0.05 0.1 0.2 0.5 0.75 1 0.25e1 0.5e1 0.75e1 1.e1 1.25e1 1.5e1 1.75e1 2e1 4e1 6e1 8e1 1e2
  # FORMAT TECPLOT POINT
  FORMAT HDF5
  FORMAT TECPLOT POINT
  VELOCITY_AT_CENTER
  PRINT_COLUMN_IDS
  MASS_BALANCE
  PERIODIC_OBSERVATION TIMESTEP 1
END

#=========================== times ============================================
TIME
  FINAL_TIME 100.d0 y  #5.d0 y
  INITIAL_TIMESTEP_SIZE 10.d0 s !s
  MAXIMUM_TIMESTEP_SIZE 5.d-3 y
END

#=========================== regions ==========================================
REGION all
  COORDINATES
    0.d0 0.d0 0.d0
    1.d0 1.d0 1.d0
  /
END
 
#=========================== transport conditions =============================
TRANSPORT_CONDITION initial
  TYPE dirichlet
  CONSTRAINT_LIST
    0.d0 initial
  /
END
 
#=========================== constraints ======================================
CONSTRAINT initial
  CONCENTRATIONS
        H+                      7.00E+00        pH
        H2O                     1.00E+00        T
        Cl-                     1.00E-10        T
        SO4--                   1.00E-10      T
        HCO3-                   1.00E-10        T 
        SiO2(aq)                1.00E-10        T
        Al+++                   1.00E-10        T
        Ca++                    1.00E-10        T
        Mg++                    1.00E-10        Z
          Fe++                 4.29e-06         T *fe
        Fe+++                   1.00E-10       T
        K+                      1.00E-10        T
        Na+                     1.00E-10       T
        O2(aq)                  1.00E-30     T
        HS-                     1.00E-10        T
          NO3-                0.000135         T *ni
        NO2-                    1.00E-10        T
        N2(aq)                  1.00E-10       T
          Ac-                 0.000251         T *ac
        NH4+	                1.00E-10       T
        CO2(aq)*                1.00E-10       T 
       # FeS(aq)                1.00E-10       T
	Mill1                    1.00E-10	T  
	Mill2                    1.00E-10       T        
/
         MINERALS
         SOM             5.00E-3        2.40E+02        #  cm^2/cm^3     # min_name     vol_frac     spe_sur_area [m2 mineral/m3 bulk]
    #    AOM              1.50E-06      1.40E+02       #  cm^2/cm^3     # min_name     vol_frac     spe_sur_area [m2 mineral/m3 bulk]
#	 Calcite         1.00E-03        6.00E+01        #  cm^2/cm^3     # min_name     vol_frac     spe_sur_area [m2 mineral/m3 bulk]
    /
END

#=========================== condition couplers ===============================
# initial condition
INITIAL_CONDITION
  TRANSPORT_CONDITION initial
  #FLOW_CONDITION initial
  REGION all
END
 
#=========================== stratigraphy couplers ============================
STRATA
  MATERIAL soil1
  REGION all
END

END_SUBSURFACE
